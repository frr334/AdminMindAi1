# Public Supabase values only. Never put the service role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: public URL of your *own* backend that proxies AI providers.
# Do not put OpenAI, Anthropic, or other secret keys here.
NEXT_PUBLIC_AI_API_URL=

# Server-only (used by /api/ai). Keep these in .env.local, never NEXT_PUBLIC_.
AI_API_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
